{
  "name": "docker-node",
  "description": "Build official Docker images for Node.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "format:toc": "doctoc --update-only .",
    "format:toc:check": "doctoc --update-only --dryrun .",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint": "run-s format:toc:check format:prettier:check lint:eslint",
    "lint:fix": "run-s format:toc format:prettier lint:eslint:fix",
    "check:markdown-links": "find *.md docs/*.md -print0 | xargs -0 -n1 markdown-link-check -c markdown_link_check_config.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "doctoc": "2.5.0",
    "eslint": "10.8.0",
    "eslint-plugin-yml": "3.6.0",
    "globals": "17.7.0",
    "markdown-link-check": "3.14.2",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6"
  }
}
